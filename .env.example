# ============================================================
# game-translator-mcp 配置示例
#
# 本工具不绑定任何特定 AI 供应商。任选一种方式配置即可：
#   方式 A（推荐，最通用）：自定义 OpenAI 兼容供应商
#   方式 B：agnes ai    方式 C：通义千问    方式 D：DeepSeek（仅作 fallback）
# 检测到哪个 key 就用哪个，优先级 custom > agnes > dashscope > deepseek。
# 复制本文件为 .env 并填写，.env 不会被提交到 Git。
# ============================================================

# ---- 方式 A：自定义 OpenAI 兼容供应商（最灵活，推荐）----
# 任意提供 OpenAI 兼容接口的平台都可用，填你的 key / 网关地址 / 模型名
TRANSLATOR_API_KEY=
TRANSLATOR_BASE_URL=
TRANSLATOR_MODEL=

# ---- 方式 B：agnes ai（只需要有对应的 key 就会生效）----
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# ---- 方式 C：通义千问 ----
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# ---- 方式 D：DeepSeek（可选，仅作主供应商失败时的 fallback）----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- 通用参数 ----
BATCH_SIZE=15                 # 每批翻译条数，越高越省 token
OUTPUT_DIR=translated_output  # 汉化输出目录
CACHE_FILE=translator_cache.json
USE_DEEPSEEK_FALLBACK=true    # 是否启用 DeepSeek fallback